# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
# vite-plugin-pwa dev output
dev-dist/

# Environment files: real values stay local. The VITE_* variables are documented in the
# README; in CI they come from the workflow and repository Variables.
.env
.env.*
!.env.example
*.local

# Tooling caches and generated scratch files
# (src/routeTree.gen.ts is generated by the router plugin but IS committed: lint and
#  tests import it before any build runs in CI)
.tanstack/
.vitest/
coverage/
*.tsbuildinfo
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Local assistant / browser-automation files
.claude/settings.local.json
.playwright-mcp/
